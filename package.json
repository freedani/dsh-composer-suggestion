{
  "name": "dsh-composer-suggestion",
  "version": "0.1.0",
  "description": "Fork of dsh-composer-predictions with one switch per trigger: the after-turn suggestion and the mid-draft prediction are enabled independently, on a Settings page of their own",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "composer",
    "autocomplete",
    "tab-completion",
    "suggestion",
    "ghost-text",
    "prompt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "catalog": {
      "summary": {
        "en": "After each completed turn, one suggested next message appears in an empty composer; press Tab to accept it and Alt+Down to cycle candidates. A second, independent switch turns on mid-draft prediction while you type.",
        "zh": "每个回合结束后在空输入框里给出一条「下一句」建议；按 Tab 采纳，Alt+↓ 切换候选。另有独立开关可开启打字停顿时的草稿预测。"
      },
      "category": "ui"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freedani/dsh-composer-suggestion.git"
  },
  "homepage": "https://github.com/freedani/dsh-composer-suggestion#readme",
  "bugs": {
    "url": "https://github.com/freedani/dsh-composer-suggestion/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  }
}
